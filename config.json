//适配sing-box 1.13.8
{
  "log": {
    "level": "error",
    "output": "singbox.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns_direct",
        "server": "223.5.5.5",
        "detour": "direct"
      },
      {
        "type": "https",
        "tag": "dns_cloudflare",
        "server": "1.1.1.1",
        "detour": "proxy"
      },
      {
        "type": "fakeip",
        "tag": "dns_fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "query_type": [
          "SVCB",
          "HTTPS"
        ],
        "action": "predefined",
        "rcode": "NOTIMP"
      },
      {
        "rule_set": [
          "geosite-category-ads-all",
          "geosite-category-httpdns-cn"
        ],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "rule_set": "geosite-cn",
        "server": "dns_direct"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "rewrite_ttl": 1,
        "server": "dns_fakeip"
      }
    ],
    "final": "dns_cloudflare",
    "strategy": "ipv4_only",
    "disable_cache": false,
    "disable_expire": false,
    "cache_capacity": 4096,
    "independent_cache": true,
    "reverse_mapping": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "stack": "system"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "vless",
        "ss"
      ],
      "default": "vless",
      "interrupt_exist_connections": false
    },
    {
      "type": "vless",
      "tag": "vless",
      "server": "xxxxxx",
      "server_port": 443,
      "uuid": "xxxxxx",
      "flow": "xtls-rprx-vision",
      "packet_encoding": "xudp",
      "tls": {
        "enabled": true,
        "server_name": "xxxxxxx",
        "curve_preferences": [
          "X25519MLKEM768"
        ],
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "xxxxx",
          "short_id": "xxxx"
        }
      },
      "tcp_keep_alive": "5m",
      "tcp_keep_alive_interval": "60s"
    },
    {
      "type": "shadowsocks",
      "tag": "ss",
      "server": "xxxxxx",
      "server_port": 56787,
      "method": "aes-256-gcm",
      "password": "xxxxx+xxxxx==",
      "plugin": "obfs-local",
      "plugin_opts": "obfs=http;obfs-host=icloud.com",
      "network": "tcp",
      "udp_over_tcp": false,
      "multiplex": {}
    }
  ],
  "route": {
    "rules": [
      {
        "rule_set": "telegram",
        "invert": true,
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "protocol": "ssh",
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "domain": [
          "browser.sentry-cdn.com",
          "ping0.cc"
        ],
        "action": "reject",
        "method": "default",
        "no_drop": false
      },
      {
        "rule_set": [
          "geosite-category-ads-all",
          "geosite-category-httpdns-cn"
        ],
        "action": "reject",
        "method": "default",
        "no_drop": false
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "telegram"
          },
          {
            "ip_version": 6
          }
        ],
        "action": "reject",
        "method": "default",
        "no_drop": false
      },
      {
        "rule_set": [
          "telegram"
        ],
        "action": "route",
        "outbound": "proxy"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "protocol": "quic"
          },
          {
            "rule_set": [
              "geosite-cn"
            ],
            "invert": true
          }
        ],
        "action": "reject",
        "method": "default",
        "no_drop": false
      },
      {
        "rule_set": "geosite-google",
        "action": "route",
        "outbound": "proxy"
      },
      {
        "rule_set": "geosite-proxy",
        "action": "route",
        "outbound": "proxy"
      },
      {
        "action": "resolve"
      },
      {
        "rule_set": [
          "geoip-cn"
        ],
        "action": "route",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/Yuu518/sing-box-rules/rule_set/rule_set_site/category-ads-all.srs",
        "download_detour": "proxy"
      },
      {
        "tag": "geosite-category-httpdns-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/nekolsd/sing-geosite/refs/heads/rule-set/category-httpdns-cn.srs",
        "download_detour": "proxy"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/nekolsd/sing-geosite/refs/heads/rule-set/cn.srs",
        "download_detour": "proxy"
      },
      {
        "tag": "geosite-proxy",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/proxy.srs",
        "download_detour": "proxy"
      },
      {
        "tag": "telegram",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/refs/heads/sing/geo/geoip/telegram.srs",
        "download_detour": "proxy"
      },
      {
        "tag": "geosite-google",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/nekolsd/sing-geosite/refs/heads/rule-set/google.srs",
        "download_detour": "proxy"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/nekolsd/geoip/refs/heads/release/srs/cn.srs",
        "download_detour": "proxy"
      }
    ],
    "default_domain_resolver": {
      "server": "dns_cloudflare",
      "rewrite_ttl": 60
    },
    "final": "proxy",
    "find_process": true,
    "auto_detect_interface": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9999",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
      "secret": "xxxxxx",
      "external_ui_download_detour": "proxy",
      "external_ui": "ui"
    },
    "cache_file": {
      "enabled": true,
      "path": "cache-nekohasekai.db",
      "cache_id": "singbox-nekohasekai",
      "store_fakeip": true,
      "store_rdrc": true
    }
  }
}
